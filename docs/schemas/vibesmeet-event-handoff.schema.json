{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demand-gig-engine.local/schemas/vibesmeet-event-handoff.schema.json",
  "title": "Demand Gig Engine to VibesMeet Event Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_id",
    "campaign_version",
    "organizer_external_id",
    "title",
    "description",
    "timezone",
    "starts_at",
    "ends_at",
    "venue",
    "artists",
    "capacity",
    "currency",
    "ticket_types",
    "reservation_claims",
    "revenue_splits",
    "attribution",
    "readiness",
    "accessibility",
    "policy"
  ],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_version": {"type": "string", "minLength": 1},
    "organizer_external_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string"},
    "timezone": {"type": "string", "minLength": 1},
    "starts_at": {"type": "string", "format": "date-time"},
    "ends_at": {"type": "string", "format": "date-time"},
    "venue": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "external_id": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "space_name": {"type": ["string", "null"]},
        "address": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "country": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "artists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "external_id": {"type": ["string", "null"]},
          "name": {"type": "string", "minLength": 1},
          "role": {"type": ["string", "null"]},
          "contract_status": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "capacity": {"type": "integer", "minimum": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "ticket_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "price", "currency", "inventory", "reserved_for_supporters"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "price": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "inventory": {"type": "integer", "minimum": 0},
          "reserved_for_supporters": {"type": "integer", "minimum": 0},
          "sales_start": {"type": ["string", "null"], "format": "date-time"},
          "sales_end": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "reservation_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservation_id",
          "supporter_external_id",
          "supporter_email",
          "quantity",
          "credit_amount",
          "currency",
          "ticket_type_code",
          "conversion_deadline",
          "referral_code",
          "source"
        ],
        "properties": {
          "reservation_id": {"type": "string", "minLength": 1},
          "supporter_external_id": {"type": ["string", "null"]},
          "supporter_email": {"type": "string", "format": "email"},
          "quantity": {"type": "integer", "minimum": 1},
          "credit_amount": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "ticket_type_code": {"type": ["string", "null"]},
          "conversion_deadline": {"type": ["string", "null"], "format": "date-time"},
          "referral_code": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "revenue_splits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant_external_id", "participant_type", "basis_points", "role"],
        "properties": {
          "participant_external_id": {"type": "string", "minLength": 1},
          "participant_type": {"type": "string", "minLength": 1},
          "basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "sponsor_opportunity": {"type": ["object", "null"]},
    "attribution": {"type": "object"},
    "readiness": {"type": "object"},
    "accessibility": {"type": "object"},
    "policy": {"type": "object"}
  }
}
