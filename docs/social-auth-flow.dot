// Author: Stan Zvenigorodskiy | DevOps Lab Inc. | https://DevOpsLabInc.com
// Purpose: Defines the source graph used to render the documented architecture or authentication-flow diagram.
// Nodes represent services or actors; directed edges represent request, data, or trust flow.

digraph SocialAuth {
  graph [rankdir=LR, bgcolor="#07111F", fontname="Arial", fontsize=22, pad=0.35, nodesep=0.5, ranksep=0.6, splines=ortho, label="Gig Engine — Social Authentication and Authorization Flow", labelloc=t, fontcolor="white", size="15,8!"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#64748B", fillcolor="#172033", fontcolor="white", margin="0.15,0.1"];
  edge [color="#9FB0C7", arrowsize=0.7, penwidth=1.2];

  browser [label="React SPA\nSign in • link provider • profile", fillcolor="#312E81", color="#A78BFA"];
  edgegw [label="CloudFront + WAF\nOne hostname\nCSRF + secure session cookie", fillcolor="#12365B", color="#60A5FA"];
  django [label="Django / DRF\nSessionAuthentication\nOwner/staff permissions", fillcolor="#0E3A54", color="#38BDF8"];
  allauth [label="django-allauth\nOAuth state + PKCE where supported\nServer-side code exchange", fillcolor="#3B2354", color="#C084FC"];
  providers [label="Google • Facebook\nInstagram • TikTok", fillcolor="#4A1D4A", color="#F0ABFC"];
  profile [label="Django user + GigUserProfile\nFan • Band • Venue • Organizer\nRental • Sponsor", fillcolor="#113B2D", color="#34D399"];
  domain [label="Gig domain ownership\nCampaign.owner\nPledge.supporter_user\nSponsor.contact_user", fillcolor="#4A351A", color="#FBBF24"];
  secrets [label="AWS Secrets Manager\nProvider client secrets\nTokens not stored for login", fillcolor="#4A1F2C", color="#FB7185"];

  browser -> edgegw -> django -> allauth -> providers;
  providers -> allauth [label=" callback + code", fontcolor="#D8B4FE"];
  allauth -> profile;
  profile -> domain;
  secrets -> allauth [style=dashed];
}
