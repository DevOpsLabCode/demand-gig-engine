# Author: Stan Zvenigorodskiy | DevOps Lab Inc. | https://DevOpsLabInc.com
# Purpose: Builds the React/Vite bundle in Node and serves the compiled SPA from an unprivileged Nginx runtime image.
# Each instruction is preceded by the reason it belongs in the image.

FROM node:22-alpine AS build

# Create an unprivileged build account and grant it ownership of the working directory.
RUN addgroup -S app && adduser -S app -G app && \
    mkdir -p /app && chown app:app /app
# Create and select the application working directory for subsequent instructions.
WORKDIR /app
# Copy package manifests before source code so dependency installation remains cacheable.
COPY --chown=app:app frontend/package*.json ./
# Drop root privileges so build or runtime processes use the dedicated unprivileged account.
USER app
# Install the frontend dependency graph without interactive funding or audit network calls during the image build.
RUN npm install --no-audit --no-fund
# Copy the React/Vite source after dependencies so ordinary code edits do not invalidate the npm layer.
COPY --chown=app:app frontend/ ./
# Declare a build-time value that can change without editing the Dockerfile.
ARG VITE_API_BASE=/api
# Set deterministic runtime defaults for the processes in this image.
ENV VITE_API_BASE=${VITE_API_BASE}
# Compile and optimize the production SPA into the dist directory.
RUN npm run build

# Start a separate minimal Nginx runtime stage; Node and build tools are not shipped to production.
FROM nginxinc/nginx-unprivileged:1.27-alpine
# Install the SPA routing, cache, and health-endpoint Nginx configuration.
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
# Copy only compiled static assets from the build stage into the production image.
COPY --from=build /app/dist /usr/share/nginx/html
# Drop root privileges so build or runtime processes use the dedicated unprivileged account.
USER 101
# Document the container port consumed by the local or cloud runtime.
EXPOSE 8080
# Confirm that Nginx is responding on its unprivileged port before the container receives traffic.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
# Fetch the local root document and fail when Nginx cannot serve the SPA.
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
