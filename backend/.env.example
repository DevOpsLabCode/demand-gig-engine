# Purpose: Documents backend environment variables without containing real secrets.

DEBUG=true
SECRET_KEY=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

# Email verification delivery. In AWS, these values can use Amazon SES SMTP credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Open Concert <no-reply@devopslabinc.com>
EMAIL_SUBJECT_PREFIX=[Open Concert]

# Meta / Facebook integration
PUBLIC_BASE_URL=http://localhost:8000
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_TEST_EVENT_CODE=
META_DEFAULT_SHARE_IMAGE=

# VibesMeet partner integration (proposed contract; confirm values with VibesMeet)
VIBESMEET_BASE_URL=
VIBESMEET_ACCESS_TOKEN=
VIBESMEET_WEBHOOK_SECRET=
VIBESMEET_WEBHOOK_TOLERANCE_SECONDS=300
VIBESMEET_TIMEOUT_SECONDS=15

# Social authentication (OAuth apps)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
INSTAGRAM_OAUTH_CLIENT_ID=
INSTAGRAM_OAUTH_CLIENT_SECRET=
TIKTOK_OAUTH_CLIENT_KEY=
TIKTOK_OAUTH_CLIENT_SECRET=
LOGIN_REDIRECT_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

SOCIAL_AUTH_ALLOWED_PROVIDERS=google,facebook,instagram,tiktok
ALLAUTH_TRUSTED_PROXY_COUNT=
REDIS_URL=
